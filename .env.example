# Used only by the currently configured default service; never auto-applied to OpenAI or custom endpoints.
RAG_DEFAULT_API_KEY=replace-with-your-default-service-key
# Optional: text embedding model for the default service.
# OPENAI_EMBEDDING_MODEL=text-embedding-v4
# Optional: model name in your local Ollama installation.
# LOCAL_EMBEDDING_MODEL=bge-m3

# Managed workspace data directory; defaults to ./data (keep a backup of the whole directory).
# RAG_DATA_DIR=C:/work/RAG/data
# SQLite DB override only if you intentionally keep metadata elsewhere.
# RAG_DB_PATH=C:/work/RAG/data/knowledge.sqlite3
# The pre-multitenancy legacy pages are disabled by default. Only enable on a trusted single-user machine.
RAG_ENABLE_LEGACY=false
# Managed-account keys must be entered and saved per account (Windows DPAPI);
# the legacy RAG_DEFAULT_API_KEY above is NOT shared with managed accounts.

# Optional local browser login lifetime (days), 1-30. Uncheck 'keep me signed in' on shared machines.
RAG_LOGIN_TTL_DAYS=7

# For a reverse proxy/hosted HTTPS origin, set to your actual public URL after deployment.
# RAG_PUBLIC_ORIGIN=https://your-app.example.com
